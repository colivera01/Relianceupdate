# Copy to `.env.local` (or `.env`) and fill in real values. Never commit secrets.

# --- App origin (server-side links, webhooks, email templates) ---
# Keep in sync with the public URL the browser uses (`next dev` defaults to port 3000).
APP_BASE_URL=http://localhost:3000

# --- Private beta gate ---
# Enable only for private beta deployments before DNS is pointed publicly.
BETA_GATE_ENABLED=false
BETA_GATE_PASSWORD=
BETA_GATE_COOKIE_NAME=reliance_beta_access
BETA_GATE_COOKIE_MAX_AGE_DAYS=14

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM=Reliance <no-reply@yourdomain.com>
EMAIL_REPLY_TO=you@example.com

# --- SMS ---
# Use `telnyx` for Reliance beta SMS. Twilio remains supported as a legacy fallback.
SMS_PROVIDER=telnyx

# Telnyx (SMS)
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=

# Twilio (legacy SMS fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Preferred for Twilio Sole Proprietor / A2P 10DLC sending:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx

# --- Feature flags (notification transports) ---
EMAIL_ENABLED=true
SMS_ENABLED=true

# --- OpenAI (Phase 0 / admin-only rollout) ---
# Keep OPENAI_ENABLED=false until the first Reliance AI features are explicitly ready.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=
OPENAI_ENABLED=false
OPENAI_AUDIT_LOGGING_ENABLED=true
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1
OPENAI_MODERATION_ASSISTANT_ENABLED=false
OPENAI_DISPUTE_SUMMARY_ENABLED=false
OPENAI_TRUST_SCORE_EXPLAINER_ENABLED=false
OPENAI_VENDOR_COACHING_ENABLED=false
OPENAI_VENDOR_APPROVAL_ASSISTANT_ENABLED=false
# Optional per-feature overrides:
# OPENAI_MODERATION_ASSISTANT_MODEL=gpt-5.4-mini
# OPENAI_DISPUTE_SUMMARY_MODEL=gpt-5.4-mini
# OPENAI_TRUST_SCORE_EXPLAINER_MODEL=gpt-5.4-mini
# OPENAI_VENDOR_COACHING_MODEL=gpt-5.4-mini
# OPENAI_VENDOR_APPROVAL_ASSISTANT_MODEL=gpt-5.4-mini

# --- Dev-only: POST /api/dev/notifications-test (requires NODE_ENV !== production) ---
# Use a long random value; send header x-notifications-test-secret with the same value.
NOTIFICATIONS_TEST_SECRET=

# --- Next.js public URLs (used in `src/lib/email-notifications.ts` and admin tools) ---
# Should match APP_BASE_URL origin when emails contain absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Common Reliance env (see README / deployment docs) ---
# DATABASE_URL=
# SEED_SECRET=
# NEXT_PUBLIC_API_MODE=live
# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_BYPASS_CONSENT=true

# --- Geocoding / distance readiness ---
# Leave unset to keep geocoding disabled. Distance is only calculated from real stored coordinates
# plus a real lat/lng origin passed to /api/services/discover.
# GEOCODING_PROVIDER=mapbox
# GEOCODING_API_KEY=
# MAPBOX_GEOCODING_API_KEY=
# MAPBOX_GEOCODING_ENDPOINT=
