{
  "name": "reliance-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true});\" && next dev",
    "dev:mock": "cross-env NEXT_PUBLIC_API_MODE=mock next dev",
    "dev:live": "cross-env NEXT_PUBLIC_API_MODE=live next dev",
    "promote:mock-to-live": "cross-env SEED_SECRET=devsecret node -e \"fetch('http://localhost:3000/api/admin/seed-from-mock',{method:'POST',headers:{Authorization:'Bearer devsecret'}}).then(r=>r.text()).then(console.log)\"",
    "seed:dev": "cross-env SEED_SECRET=devsecret node -e \"fetch('http://localhost:3001/api/admin/seed',{method:'POST',headers:{Authorization:'Bearer devsecret'}}).then(r=>r.text()).then(console.log)\"",
    "reset:dev": "cross-env SEED_SECRET=devsecret node -e \"fetch('http://localhost:3001/api/admin/reset',{method:'POST',headers:{Authorization:'Bearer devsecret'}}).then(r=>r.text()).then(console.log)\"",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:studio": "prisma studio",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/booking-smoke.spec.ts",
    "test:e2e:smoke:favorites": "playwright test e2e/favorites-smoke.spec.ts",
    "test:e2e:smoke:review": "playwright test e2e/review-smoke.spec.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.85.0",
    "@tanstack/react-query-devtools": "^5.85.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.522.0",
    "mssql": "^11.0.1",
    "next": "^15.3.3",
    "prisma": "^6.19.0",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-clock": "^6.0.0",
    "react-dom": "^19.1.0",
    "react-time-picker": "^7.0.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "cross-env": "^10.0.0",
    "msw": "^2.10.5",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
