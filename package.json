{
  "name": "reliance-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next dev -p 3000",
    "dev:clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true});\" && cross-env NODE_OPTIONS=--max-old-space-size=6144 next dev",
    "dev:mock": "cross-env NODE_OPTIONS=--max-old-space-size=6144 NEXT_PUBLIC_API_MODE=mock next dev",
    "dev:live": "cross-env NODE_OPTIONS=--max-old-space-size=6144 NEXT_PUBLIC_API_MODE=live next dev",
    "promote:mock-to-live": "cross-env SEED_SECRET=devsecret node -e \"fetch('http://localhost:3000/api/admin/seed-from-mock',{method:'POST',headers:{Authorization:'Bearer devsecret'}}).then(r=>r.text()).then(console.log)\"",
    "seed:dev": "cross-env SEED_SECRET=devsecret node -e \"fetch('http://localhost:3001/api/admin/seed',{method:'POST',headers:{Authorization:'Bearer devsecret'}}).then(r=>r.text()).then(console.log)\"",
    "reset:dev": "cross-env SEED_SECRET=devsecret node -e \"fetch('http://localhost:3001/api/admin/reset',{method:'POST',headers:{Authorization:'Bearer devsecret'}}).then(r=>r.text()).then(console.log)\"",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:studio": "prisma studio",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "node scripts/dev/run-playwright-live-aware.cjs e2e/booking-smoke.spec.ts",
    "test:e2e:smoke:auth": "node scripts/dev/run-playwright-live-aware.cjs --skip-global-db-setup e2e/auth-redirect-smoke.spec.ts",
    "test:e2e:smoke:employee": "node scripts/dev/run-playwright-live-aware.cjs --skip-global-db-setup e2e/employee-jobs-smoke.spec.ts",
    "test:e2e:smoke:favorites": "node scripts/dev/run-playwright-live-aware.cjs e2e/favorites-smoke.spec.ts",
    "test:e2e:smoke:review": "node scripts/dev/run-playwright-live-aware.cjs e2e/review-smoke.spec.ts",
    "test:e2e:smoke:routes": "node scripts/dev/run-playwright-live-aware.cjs --skip-global-db-setup e2e/route-smoke.spec.ts",
    "test:ai:focused": "vitest run src/lib/ai/moderation-assistant.test.ts src/lib/ai/dispute-summary-assistant.test.ts src/lib/ai/vendor-coaching-summary-assistant.test.ts src/lib/ai/evals.test.ts src/lib/ai/output-guards.test.ts src/lib/ai/feedback.test.ts src/lib/ai/reporting.test.ts src/lib/ai/rollout-status.test.ts src/lib/ai/prompt-registry.test.ts src/app/api/admin/ai/feedback/route.test.ts src/app/api/admin/activity/ai-export/route.test.ts src/app/api/admin/media/admin-media-moderation-ai.integration.test.ts src/app/api/admin/reported-content/reported-content-ai.integration.test.ts src/app/api/vendor/coaching-summary/route.test.ts",
    "test:ai:gate": "npm run test:ai:focused && npx tsc --noEmit --pretty false --incremental false && npm run test:ai:evals",
    "test:ai:smoke": "node scripts/dev/ai-admin-smoke.cjs",
    "test:ai:evals": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"Node\\\"} ts-node --transpile-only scripts/dev/ai-admin-evals.ts",
    "geocode:backfill": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"Node\\\"} ts-node --transpile-only scripts/geocode-backfill.ts",
    "geocode:backfill:dry-run": "cross-env TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"Node\\\"} ts-node --transpile-only scripts/geocode-backfill.ts --dry-run"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.85.0",
    "@tanstack/react-query-devtools": "^5.85.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.522.0",
    "mssql": "^11.0.1",
    "next": "^15.3.3",
    "openai": "^6.41.0",
    "prisma": "^6.19.0",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-clock": "^6.0.0",
    "react-dom": "^19.1.0",
    "react-time-picker": "^7.0.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^5.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "cross-env": "^10.0.0",
    "msw": "^2.10.5",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
