  vendor     Vendor           @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  device     Device           @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membership VendorMembership @relation(fields: [membershipId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vendorId])
  @@index([deviceId, unassignedAt])
  @@map("device_assignments")
}

model MediaAsset {
  id                     String    @id @default(cuid())
  vendorId               String // Required: profile owner
  mediaSessionId         String?
  membershipId           String? // Who captured/uploaded
  uploadedByMembershipId String?
  deviceId               String? // Which headset/phone
  bytes                  BigInt // File size in bytes
  mimeType               String // MIME type (e.g., "image/jpeg", "video/mp4")
  blobKey                String // Blob storage key (e.g., "vendor/{vendorId}/media/{assetId}.{ext}")
  blobUrl                String? // Full URL to blob (optional, can be generated from blobKey)
  moderationStatus       String    @default("pending_review")
  visibilityStatus       String    @default("private")
  archiveStatus          String    @default("active")
  uploadState            String    @default("SAVED")
  contentHash            String?
  hashAlgorithm          String?   @default("SHA-256")
  captureProvenance      String    @default("LEGACY_UNKNOWN")
  stageVersion           Int?
  replacesMediaAssetId   String?
  publicEligible         Boolean?
  moderationReason       String?
  moderatedAt            DateTime?
  moderatedByUserId      String?
  deletedAt              DateTime? // Soft delete timestamp
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mediaSession MediaSession? @relation(fields: [mediaSessionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([vendorId, deletedAt])
  @@index([mediaSessionId])
  @@index([membershipId])
  @@index([deviceId])
  @@index([contentHash])
  @@index([replacesMediaAssetId])
  @@map("media_assets")
}

model MediaSession {
  id                      String    @id @default(cuid())
  vendorId                String
  userId                  String?
  employeeId              String?
  bookingId               String?
  serviceId               String?
  deviceId                String?
  deviceType              String? // "PHONE" | "HEADSET"
  sessionType             String    @default("SERVICE_RECORD")
  /**
   * Vendor job service video stage: INTRO | IN_PROGRESS | COMPLETED (null = legacy / non-staged)
   */
  vendorJobVideoStage     String?
  status                  String    @default("CREATED")
  title                   String?
  description             String?
  recordingGateDecisionId String?
  capturedByMembershipId  String?
  startedAt               DateTime  @default(now())
  endedAt                 DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  vendor         Vendor          @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User?           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee       Employee?       @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service        Service?        @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  device         Device?         @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mediaAssets    MediaAsset[]
  reviewWindows  ReviewWindow[]
  consentRecords ConsentRecord[]
  reviews        Review[]

  @@index([vendorId, createdAt])
  @@index([vendorId, status])
  @@index([vendorId, sessionType])
  @@index([deviceId])
  @@index([bookingId])
  @@index([recordingGateDecisionId])
  @@map("media_sessions")
}

model VendorStorageAlert {
  id        String   @id @default(cuid())
  vendorId  String
  threshold Int // 80, 95, or 100
  sentAt    DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, threshold])
  @@index([vendorId])
  @@map("vendor_storage_alerts")
}

model AdminNotification {
  id        String   @id @default(cuid())
  vendorId  String?
  type      String // "STORAGE_ALERT" | "STORAGE_LIMIT_REACHED" | etc.
  title     String
  message   String
  metadata  String? // JSON string for additional data
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([read, createdAt])
  @@index([vendorId])
  @@map("admin_notifications")
}

model ContentReport {
  id                 String    @id @default(cuid())
  targetType         String
  targetId           String
  bookingId          String?
  vendorId           String?
  reportedUserId     String?
  reportedVendorId   String?
  reporterUserId     String?
  reporterVendorId   String?
  reporterRole       String
  reasonCategory     String
  reasonDetail       String?   @db.NVarChar(Max)
  status             String    @default("open")
  severity           String    @default("medium")
  autoHidden         Boolean   @default(false)
  adminOwnerUserId   String?
  notificationSentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resolvedAt         DateTime?
  resolutionNotes    String?   @db.NVarChar(Max)

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([vendorId, createdAt])
  @@index([reportedUserId, createdAt])
  @@index([reportedVendorId, createdAt])
  @@map("content_reports")
}

model BookingServiceIssue {
  id                String    @id @default(cuid())
  bookingId         String
  vendorId          String
  issueType         String
  status            String    @default("PENDING")
  sourceEntityType  String?
  sourceEntityId    String?
  reportedByUserId  String?
  validatedAt       DateTime?
  rejectedAt        DateTime?
  refundApprovedAt  DateTime?
  finalizedAt       DateTime?
  finalizedByUserId String?
  resolutionNotes   String?   @db.NVarChar(Max)
  metadata          String?   @db.NVarChar(Max)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bookingId, status])
  @@index([vendorId, status, finalizedAt])
  @@index([issueType, status])
  @@index([sourceEntityType, sourceEntityId])
  @@map("booking_service_issues")
}

model VendorOperationalOutcome {
  id                String   @id @default(cuid())
  vendorId          String
  bookingId         String?
  outcomeType       String
  status            String   @default("FINALIZED")
  sourceEntityType  String?
  sourceEntityId    String?
  finalizedAt       DateTime
  finalizedByUserId String?
  metadata          String?  @db.NVarChar(Max)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor  Vendor   @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vendorId, outcomeType, finalizedAt])
  @@index([bookingId, outcomeType])
  @@index([sourceEntityType, sourceEntityId])
  @@map("vendor_operational_outcomes")
}

// Trust Score Phase 1B: internal-only platform-generated score snapshots.
// Separate from `Review` (Customer Rating). `visibilityStatus` defaults to "internal"
// so no public/vendor surface reads these rows until a later UI phase opts in.
model VendorTrustScoreSnapshot {
  id                                String    @id @default(cuid())
  vendorId                          String
  scoreVersion                      Int       @default(1)
  // Null pct = metric/total not yet measurable (no finalized denominator).
  totalScorePct                     Float?
  workflowCompletionPct             Float?
  videoVerificationPct              Float?
  disputeFreePct                    Float?
  operationalReliabilityPct         Float?
  workflowCompletionNumerator       Int       @default(0)
  workflowCompletionDenominator     Int       @default(0)
  videoVerificationNumerator        Int       @default(0)
  videoVerificationDenominator      Int       @default(0)
  disputeFreeNumerator              Int       @default(0)
  disputeFreeDenominator            Int       @default(0)
  operationalReliabilityNumerator   Int       @default(0)
  operationalReliabilityDenominator Int       @default(0)
  computedAt                        DateTime  @default(now())
  periodStart                       DateTime?
  periodEnd                         DateTime?
  inputHash                         String?
  isCurrent                         Boolean   @default(true)
  visibilityStatus                  String    @default("internal")
  recalcReason                      String?
  recalcSource                      String?
  detailJson                        String?   @db.NVarChar(Max)
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vendorId, isCurrent])
  @@index([vendorId, computedAt])
  @@index([inputHash])
  @@map("vendor_trust_score_snapshots")
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  actionType    String
  entityType    String
  entityId      String
  actorUserId   String
  previousValue String?
  newValue      String?
  metadata      String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actionType, createdAt])
  @@map("admin_audit_logs")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  serviceId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([userId, createdAt])
  @@index([serviceId])
  @@map("favorites")
}

model ReviewWindow {
  id             String    @id @default(cuid())
  bookingId      String
  vendorId       String
  mediaSessionId String
  reviewId       String?   @unique
  status         String    @default("active")
  openedAt       DateTime  @default(now())
  expiresAt      DateTime // Deprecated compatibility field; not used to govern review eligibility.
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  booking      Booking             @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mediaSession MediaSession        @relation(fields: [mediaSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  review       Review?             @relation(fields: [reviewId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  promptEvents ReviewPromptEvent[]
  sentiments   ReviewSentiment[]

  @@index([bookingId, status])
  @@index([vendorId, createdAt])
  @@index([mediaSessionId])
  @@map("review_windows")
}

model ReviewPromptEvent {
  id             String   @id @default(cuid())
  reviewWindowId String
  eventType      String
  metadata       String?
  createdAt      DateTime @default(now())

  reviewWindow ReviewWindow @relation(fields: [reviewWindowId], references: [id], onDelete: Cascade)

  @@index([reviewWindowId, createdAt])
  @@index([eventType, createdAt])
  @@map("review_prompt_events")
}

model ReviewSentiment {
  id             String   @id @default(cuid())
  reviewWindowId String
  sentiment      String
  createdAt      DateTime @default(now())

  reviewWindow ReviewWindow @relation(fields: [reviewWindowId], references: [id], onDelete: Cascade)

  @@index([reviewWindowId, createdAt])
  @@index([sentiment, createdAt])
  @@map("review_sentiments")
}

model ConsentRecord {
  id                   String    @id @default(cuid())
  token                String?   @unique
  bookingId            String
  vendorId             String
  mediaSessionId       String?
  consentType          String
  status               String    @default("requested")
  lifecycleStatus      String    @default("PENDING")
  generation           Int       @default(1)
  isCurrent            Boolean   @default(false)
  verifiedDecision     Boolean   @default(false)
  legacyEvidence       Boolean   @default(false)
  recipientName        String?
  recipientEmailHash   String?
  recipientPhoneHash   String?
  recipientEmailMasked String?
  recipientPhoneMasked String?
  recipientMismatch    Boolean   @default(false)
  scopeJson            String?   @db.NVarChar(Max)
  scopeHash            String?
  audioEnabled         Boolean   @default(false)
  contentVersionId     String?
  supersededAt         DateTime?
  wrongRecipientAt     DateTime?
  requestedAt          DateTime  @default(now())
  acceptedAt           DateTime?
  declinedAt           DateTime?
  expiresAt            DateTime?
  termsVersion         String?
  privacyVersion       String?
  ipAddress            String?
  userAgent            String?
  documentHash         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  booking                Booking                        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendor                 Vendor                         @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mediaSession           MediaSession?                  @relation(fields: [mediaSessionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  contentVersion         ConsentContentVersion?         @relation(fields: [contentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events                 ConsentEvent[]
  requestLinks           ConsentRequestLink[]
  verificationChallenges ConsentVerificationChallenge[]
  decisionSessions       ConsentDecisionSession[]
  decisionEvidence       ConsentDecisionEvidence?

  @@index([bookingId, status])
  @@index([bookingId, isCurrent])
  @@index([vendorId, createdAt])
  @@index([mediaSessionId])
  @@index([lifecycleStatus, expiresAt])
  @@index([recipientEmailHash])
  @@index([recipientPhoneHash])
  @@index([contentVersionId])
  @@map("consent_records")
}

model ConsentContentVersion {
  id                 String    @id @default(cuid())
  version            String    @unique
  contentJson        String    @db.NVarChar(Max)
  contentHash        String    @unique
  scopeSchemaVersion String
  effectiveAt        DateTime
  retiredAt          DateTime?
  createdAt          DateTime  @default(now())

  consentRecords ConsentRecord[]

  @@index([effectiveAt, retiredAt])
  @@map("consent_content_versions")
}

model ConsentRequestLink {
  id               String    @id @default(cuid())
  consentRecordId  String
  secretHash       String    @unique
  generation       Int
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  lastViewedAt     DateTime?
  createdAt        DateTime  @default(now())

  consentRecord ConsentRecord                  @relation(fields: [consentRecordId], references: [id], onDelete: Cascade)
  challenges    ConsentVerificationChallenge[]

  @@unique([consentRecordId, generation])
  @@index([consentRecordId, revokedAt, expiresAt])
  @@map("consent_request_links")
}

model ConsentVerificationChallenge {
  id              String    @id @default(cuid())
  consentRecordId String
  requestLinkId   String
  channel         String
  destinationHash String
  codeHash        String
  expiresAt       DateTime
  failedAttempts  Int       @default(0)
  maxAttempts     Int       @default(5)
  consumedAt      DateTime?
  requestIpHash   String?
  createdAt       DateTime  @default(now())

  consentRecord ConsentRecord      @relation(fields: [consentRecordId], references: [id], onDelete: Cascade)
  requestLink   ConsentRequestLink @relation(fields: [requestLinkId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([consentRecordId, channel, createdAt])
  @@index([destinationHash, createdAt])
  @@index([expiresAt, consumedAt])
  @@map("consent_verification_challenges")
}

model ConsentDecisionSession {
  id                  String    @id @default(cuid())
  consentRecordId     String
  secretHash          String    @unique
  verificationMethod  String
  verifiedContactHash String?
  verifiedUserId      String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  consentRecord ConsentRecord @relation(fields: [consentRecordId], references: [id], onDelete: Cascade)

  @@index([consentRecordId, expiresAt, consumedAt])
  @@map("consent_decision_sessions")
}

model ConsentDecisionEvidence {
  id                  String   @id @default(cuid())
  consentRecordId     String   @unique
  decision            String
  actorUserId         String?
  claimedRole         String
  authorityScope      String
  verificationMethod  String
  verifiedContactHash String?
  requestHash         String
  scopeHash           String
  contentHash         String
  contentVersion      String
  ipAddress           String?
  userAgent           String?
  metadata            String?  @db.NVarChar(Max)
  decidedAt           DateTime @default(now())
  createdAt           DateTime @default(now())

  consentRecord ConsentRecord @relation(fields: [consentRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([decision, decidedAt])
  @@index([actorUserId, decidedAt])
  @@map("consent_decision_evidence")
}

model ConsentEvent {
  id              String   @id @default(cuid())
  consentRecordId String
  eventType       String
  metadata        String?
  createdAt       DateTime @default(now())

  consentRecord ConsentRecord @relation(fields: [consentRecordId], references: [id], onDelete: Cascade)

  @@index([consentRecordId, createdAt])
  @@index([eventType, createdAt])
  @@map("consent_events")
}
