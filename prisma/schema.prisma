// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  // Native library engine required for `sqlserver://` DATABASE_URL. Do not run `prisma generate --no-engine`.
  engineType    = "library"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// SQL Server doesn't support Prisma enums, using String instead
// EmployeeRole: "MANAGER" | "TECHNICIAN"
// BookingStatus: "PENDING" | "CONFIRMED" | "COMPLETED" | "CANCELED"

// SQL Server in this environment does not support Prisma enums.
// Keep enum-like values as strings at the application layer.

model Vendor {
  id                      String    @id @default(cuid())
  firstName               String?
  lastName                String?
  name                    String // Keep for backward compatibility
  businessName            String?
  businessType            String?
  category                String?
  foundedYear             Int?
  email                   String?   @unique
  phone                   String?
  city                    String?
  state                   String?
  address                 String?
  zipCode                 String?
  latitude                Float?
  longitude               Float?
  geocodedAt              DateTime?
  bio                     String?
  website                 String?
  licenseNumber           String?
  insuranceStatus         Boolean   @default(false)
  insuranceProvider       String?
  insuranceExpiry         DateTime?
  bondingStatus           Boolean   @default(false)
  emergencyContact        String?
  responseTimeSettings    String?
  businessHoursJson       String?   @db.NVarChar(Max)
  profilePhoto            String?
  serviceTypes            String? // Can be comma-separated for now
  specializations         String? // Can be comma-separated for now
  serviceAreas            String? // Can be comma-separated for now
  // Payments
  paymentsEnabled         Boolean   @default(false)
  // Reminders
  reminders_review        Boolean   @default(true)
  reminders_invoice       Boolean   @default(false)
  reminders_maintenance   Boolean   @default(true)
  reminders_followUp      Boolean   @default(true)
  // Notifications
  notifications_job       Boolean   @default(true)
  notifications_review    Boolean   @default(true)
  notifications_payout    Boolean   @default(false)
  notifications_support   Boolean   @default(true)
  notifications_marketing Boolean   @default(false)
  notifications_updates   Boolean   @default(true)
  // Security Settings
  twoFactorEnabled        Boolean   @default(false)
  loginNotifications      Boolean   @default(true)
  sessionTimeout          Int       @default(30)
  passwordExpiry          Int? // Optional for now
  failedLoginLockout      Int? // Optional for now
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  demo                    Boolean   @default(false)
  seedBatchId             String?

  // Storage plan & limits
  planKey                 String    @default("FREE") // "FREE" | "STARTER" | "PRO"
  storageLimitBytes       BigInt    @default(1073741824) // 1GB default for FREE
  isOverLimit             Boolean   @default(false)
  overLimitSince          DateTime?
  isPubliclyListed        Boolean   @default(false)
  publiclyListedAt        DateTime?
  accountStatus           String    @default("active")
  accountStatusUpdatedAt  DateTime?
  accountStatusReason     String?
  accountStatusAdminNotes String?   @db.NVarChar(Max)

  // Relations
  employees                   Employee[]
  services                    Service[]
  bookings                    Booking[]
  reviews                     Review[]
  devices                     Device[]
  devicePairingCodes          DevicePairingCode[]
  memberships                 VendorMembership[]
  invites                     VendorInvite[]
  deviceAssignments           DeviceAssignment[]
  mediaAssets                 MediaAsset[]
  mediaSessions               MediaSession[]
  reviewWindows               ReviewWindow[]
  consentRecords              ConsentRecord[]
  storageAlerts               VendorStorageAlert[]
  adminNotifications          AdminNotification[]
  promotionCampaigns          PromotionCampaign[]
  serviceIssues               BookingServiceIssue[]
  operationalOutcomes         VendorOperationalOutcome[]
  trustScoreSnapshots         VendorTrustScoreSnapshot[]
  recordingAssessments        RecordingScopeAssessment[]
  recordingCertifications     EmployeeRecordingCertification[]
  recordingLocationAttempts   RecordingLocationAttempt[]
  recordingLocationExceptions RecordingLocationException[]
  recordingGateMetrics        RecordingGateMetric[]

  @@map("vendors")
}

model Employee {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  email       String
  role        String // "MANAGER" | "TECHNICIAN"
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  demo        Boolean  @default(false)
  seedBatchId String?

  // Relations
  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  mediaSessions MediaSession[]

  @@map("employees")
}

model Service {
  id          String    @id @default(cuid())
  vendorId    String
  name        String
  description String?
  price       Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  demo        Boolean   @default(false)
  seedBatchId String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // Relations
  vendor             Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  mediaSessions      MediaSession[]
  favorites          Favorite[]
  promotionCampaigns PromotionCampaign[]

  @@map("services")
}

model PromotionCampaign {
  id                   String    @id @default(cuid())
  vendorId             String
  serviceId            String?
  name                 String
  packageKey           String    @default("browse-local-7-day")
  packageSnapshotJson  String?   @db.NVarChar(Max)
  packageSnapshotAt    DateTime?
  placementType        String    @default("BROWSE_FEATURED")
  status               String    @default("draft")
  paymentStatus        String    @default("not_started")
  startAt              DateTime
  endAt                DateTime
  targetCategory       String?
  targetCity           String?
  targetState          String?
  targetZip            String?
  targetRadiusMiles    Int       @default(10)
  rankPriority         Int       @default(100)
  adminNotes           String?   @db.NVarChar(Max)
  amountDueCents       Int       @default(0)
  stripePaymentLinkUrl String?   @db.NVarChar(2048)
  paymentReference     String?
  paidAt               DateTime?
  paymentNotes         String?   @db.NVarChar(Max)
  createdByUserId      String?
  approvedByUserId     String?
  approvedAt           DateTime?
  pausedAt             DateTime?
  endedAt              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  vendor  Vendor   @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, placementType, startAt, endAt])
  @@index([vendorId, status])
  @@index([serviceId])
  @@index([targetCategory])
  @@index([paymentStatus])
  @@index([packageKey])
  @@index([paidAt])
  @@map("promotion_campaigns")
}

model PromotionPackage {
  id                     String   @id @default(cuid())
  packageKey             String   @unique
  name                   String
  publicSummary          String   @db.NVarChar(1000)
  adminDescription       String   @db.NVarChar(Max)
  bestFor                String   @db.NVarChar(1000)
  placementExplanation   String   @db.NVarChar(1000)
  audience               String   @db.NVarChar(1000)
  placementType          String
  durationDays           Int
  defaultRadiusMiles     Int
  maxRadiusMiles         Int
  allowCategoryTargeting Boolean  @default(false)
  maxConcurrentInZone    Int
  defaultPriceCents      Int
  isActive               Boolean  @default(true)
  isFoundingRate         Boolean  @default(false)
  pricingLabel           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([isActive, placementType])
  @@map("promotion_packages")
}

model User {
  id                        String    @id @default(cuid())
  name                      String?
  email                     String?   @unique
  phone                     String?   @unique
  profilePhoto              String?
  address                   String?
  city                      String?
  state                     String?
  zipCode                   String?
  latitude                  Float?
  longitude                 Float?
  geocodedAt                DateTime?
  locationPreferenceEnabled Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  demo                      Boolean   @default(false)
  seedBatchId               String?
  accountStatus             String    @default("active")
  accountStatusUpdatedAt    DateTime?
  accountStatusReason       String?
  accountStatusAdminNotes   String?   @db.NVarChar(Max)

  // Relations
  authCredential               AuthCredential?
  bookings                     Booking[]
  reviews                      Review[]
  memberships                  VendorMembership[]
  platformRoleGrants           PlatformRoleGrant[]            @relation("PlatformRoleGrantUser")
  platformRolesGranted         PlatformRoleGrant[]            @relation("PlatformRoleGrantGrantedBy")
  invitesCreated               VendorInvite[]                 @relation("InvitesCreated")
  mediaSessions                MediaSession[]
  favorites                    Favorite[]
  customerRegistrationEvidence CustomerRegistrationEvidence[]

  @@map("users")
}

model PolicyDocumentVersion {
  id              String   @id
  policyId        String
  version         String
  effectiveAt     DateTime
  contentHash     String   @unique
  contentSnapshot String   @db.NVarChar(Max)
  sourceRevision  String?
  createdAt       DateTime @default(now())

  termsAcceptances   CustomerRegistrationEvidence[] @relation("CustomerRegistrationTermsPolicy")
  privacyAcceptances CustomerRegistrationEvidence[] @relation("CustomerRegistrationPrivacyPolicy")
  smsAcceptances     CustomerRegistrationEvidence[] @relation("CustomerRegistrationSmsPolicy")

  @@unique([policyId, version])
  @@index([policyId, effectiveAt])
  @@map("policy_document_versions")
}

model CustomerRegistrationEvidence {
  id                      String    @id @default(cuid())
  userId                  String
  actorEmail              String
  actorRole               String    @default("CUSTOMER")
  registeredAt            DateTime
  termsPolicyVersionId    String
  privacyPolicyVersionId  String
  smsPolicyVersionId      String?
  termsAcceptedAt         DateTime
  privacyAcknowledgedAt   DateTime
  smsOptIn                Boolean   @default(false)
  smsDecisionAt           DateTime
  registrationIp          String?
  userAgent               String?
  verificationMethod      String
  verificationCompletedAt DateTime?
  createdAt               DateTime  @default(now())

  user          User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  termsPolicy   PolicyDocumentVersion  @relation("CustomerRegistrationTermsPolicy", fields: [termsPolicyVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  privacyPolicy PolicyDocumentVersion  @relation("CustomerRegistrationPrivacyPolicy", fields: [privacyPolicyVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  smsPolicy     PolicyDocumentVersion? @relation("CustomerRegistrationSmsPolicy", fields: [smsPolicyVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, registeredAt])
  @@index([actorEmail, registeredAt])
  @@index([verificationCompletedAt])
  @@map("customer_registration_evidence")
}

// PlatformRole: "ADMIN"
// PlatformRoleStatus: "ACTIVE" | "REVOKED"
model PlatformRoleGrant {
  id              String    @id @default(cuid())
  userId          String
  role            String
  status          String    @default("ACTIVE")
  grantedAt       DateTime  @default(now())
  grantedByUserId String?
  revokedAt       DateTime?
  revokedByUserId String?
  reason          String?   @db.NVarChar(1000)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User  @relation("PlatformRoleGrantUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grantedBy User? @relation("PlatformRoleGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, role])
  @@index([role, status])
  @@index([userId, status])
  @@map("platform_role_grants")
}

model AuthCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  email             String    @unique
  passwordHash      String
  emailVerifiedAt   DateTime?
  passwordUpdatedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailVerificationTokens EmailVerificationToken[]
  mfaChallenges           AuthMfaChallenge[]
  trustedDevices          AuthTrustedDevice[]
  passkeys                AuthPasskey[]
  passkeyChallenges       AuthPasskeyChallenge[]

  @@index([email])
  @@map("auth_credentials")
}

model AuthPasskey {
  id                  String    @id @default(cuid())
  credentialId        String    @unique
  credentialPublicKey String
  webauthnUserId      String
  counter             Int       @default(0)
  transportsJson      String?
  deviceType          String
  backedUp            Boolean   @default(false)
  label               String?
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  authCredentialId    String

  credential AuthCredential @relation(fields: [authCredentialId], references: [id], onDelete: Cascade)

  @@index([authCredentialId, revokedAt, createdAt])
  @@map("auth_passkeys")
}

model AuthPasskeyChallenge {
  id               String    @id @default(cuid())
  authCredentialId String
  challenge        String
  purpose          String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  credential AuthCredential @relation(fields: [authCredentialId], references: [id], onDelete: Cascade)

  @@index([authCredentialId, purpose, consumedAt, expiresAt])
  @@map("auth_passkey_challenges")
}

model EmailVerificationToken {
  id           String    @id @default(cuid())
  credentialId String
  email        String
  tokenHash    String    @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  credential AuthCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, email, consumedAt])
  @@index([email, expiresAt])
  @@map("email_verification_tokens")
}

model AuthMfaChallenge {
  id           String    @id @default(cuid())
  credentialId String
  userId       String
  email        String
  codeHash     String
  purpose      String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  credential AuthCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([credentialId, purpose, expiresAt])
  @@map("auth_mfa_challenges")
}

model AuthTrustedDevice {
  id           String    @id @default(cuid())
  credentialId String
  userId       String
  tokenHash    String    @unique
  label        String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  credential AuthCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([credentialId, expiresAt])
  @@map("auth_trusted_devices")
}

model Booking {
  id                 String    @id @default(cuid())
  userId             String
  serviceId          String
  vendorId           String
  title              String? // Job/service title
  clientName         String? // Client name (or use user relation)
  amount             Decimal? // Booking amount (DECIMAL in SQL for precision)
  status             String    @default("PENDING") // "PENDING" | "CONFIRMED" | "COMPLETED" | "CANCELED"
  scheduledFor       DateTime?
  date               DateTime? // Job completion or scheduled date
  rejectionReason    String?
  rejectedAt         DateTime?
  rejectedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  demo               Boolean   @default(false)
  seedBatchId        String?
  /**
   * JSON string (snake_case keys). SQL Server provider has no Prisma `Json` type — use `String` + app parse/stringify.
   */
  customerMetadata   String?   @db.NVarChar(Max)
  creationRequestKey String?

  // Relations
  user                        User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  service                     Service                          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vendor                      Vendor                           @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mediaSessions               MediaSession[]
  reviewWindows               ReviewWindow[]
  consentRecords              ConsentRecord[]
  reviews                     Review[]
  serviceIssues               BookingServiceIssue[]
  operationalOutcomes         VendorOperationalOutcome[]
  notifications               BookingNotification[]
  recordingAssessments        RecordingScopeAssessment[]
  recordingCertifications     EmployeeRecordingCertification[]
  recordingLocationAttempts   RecordingLocationAttempt[]
  recordingLocationExceptions RecordingLocationException[]
  recordingGateMetrics        RecordingGateMetric[]

  @@map("bookings")
}

// Durable recording scope selected before a work record can be released.
// Enum-like values remain strings because the production database is SQL Server.
model RecordingScopeAssessment {
  id                                 String    @id @default(cuid())
  bookingId                          String
  vendorId                           String
  generation                         Int       @default(1)
  isCurrent                          Boolean   @default(true)
  status                             String    @default("COMPLETE")
  locationType                       String
  riskLevel                          String
  propertyScope                      String
  peopleScope                        String
  frameControl                       String
  subjectJson                        String    @db.NVarChar(Max)
  scopeJson                          String    @db.NVarChar(Max)
  scopeHash                          String
  audioRequested                     Boolean   @default(false)
  audioAllowed                       Boolean   @default(false)
  permissionRequired                 Boolean
  noticeRequired                     Boolean   @default(true)
  serviceCanContinueWithoutRecording Boolean
  essentialPrivateRecording          Boolean   @default(false)
  authorityHolderType                String
  completedByUserId                  String
  completedAt                        DateTime  @default(now())
  supersededAt                       DateTime?
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt

  booking            Booking                          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendor             Vendor                           @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorities        RecordingAuthorityRequirement[]
  certifications     EmployeeRecordingCertification[]
  locationAttempts   RecordingLocationAttempt[]
  locationExceptions RecordingLocationException[]

  @@unique([bookingId, generation])
  @@index([bookingId, isCurrent])
  @@index([vendorId, createdAt])
  @@index([scopeHash])
  @@map("recording_scope_assessments")
}

model RecordingAuthorityRequirement {
  id                String    @id @default(cuid())
  assessmentId      String
  authorityType     String
  status            String    @default("PENDING")
  required          Boolean   @default(true)
  actorUserId       String?
  evidenceReference String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assessment RecordingScopeAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, authorityType])
  @@index([assessmentId, status])
  @@map("recording_authority_requirements")
}

model EmployeeRecordingCertification {
  id                   String    @id @default(cuid())
  bookingId            String
  vendorId             String
  membershipId         String
  assessmentId         String
  assignmentGeneration Int
  scopeHash            String
  status               String    @default("ACTIVE")
  certifiedByUserId    String
  certifiedAt          DateTime  @default(now())
  invalidatedAt        DateTime?
  invalidationReason   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  booking    Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendor     Vendor                   @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessment RecordingScopeAssessment @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bookingId, membershipId, status])
  @@index([assessmentId, status])
  @@index([scopeHash])
  @@map("employee_recording_certifications")
}

model RecordingLocationAttempt {
  id             String   @id @default(cuid())
  bookingId      String
  vendorId       String
  membershipId   String?
  assessmentId   String
  status         String
  resultCode     String
  method         String   @default("DEVICE_GEOLOCATION")
  distanceMeters Int?
  accuracyMeters Int?
  actorUserId    String?
  attemptedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  booking    Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendor     Vendor                   @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessment RecordingScopeAssessment @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bookingId, membershipId, attemptedAt])
  @@index([assessmentId, status, attemptedAt])
  @@map("recording_location_attempts")
}

model RecordingLocationException {
  id                      String    @id @default(cuid())
  bookingId               String
  vendorId                String
  assessmentId            String
  requestedByUserId       String
  requestedByMembershipId String?
  reason                  String    @db.NVarChar(Max)
  evidenceJson            String?   @db.NVarChar(Max)
  status                  String    @default("PENDING")
  decidedByAdminUserId    String?
  decisionNote            String?   @db.NVarChar(Max)
  decidedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  booking    Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendor     Vendor                   @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessment RecordingScopeAssessment @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bookingId, status, createdAt])
  @@index([assessmentId, status])
  @@index([decidedByAdminUserId, decidedAt])
  @@map("recording_location_exceptions")
}

// Internal diagnostic event only. It is intentionally disconnected from
// reviews, Trust Score, permissions, publication, and product dashboards.
model RecordingGateMetric {
  id                     String   @id @default(cuid())
  bookingId              String
  vendorId               String
  surface                String
  blockReason            String
  responsibleParticipant String
  actorKind              String?
  createdAt              DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([blockReason, createdAt])
  @@index([bookingId, createdAt])
  @@map("recording_gate_metrics")
}

// Immutable evidence that the canonical recording gate allowed a capture boundary.
model RecordingGateDecisionEvidence {
  id                   String   @id @default(cuid())
  bookingId            String
  vendorId             String
  assessmentId         String
  assessmentGeneration Int
  scopeHash            String
  permissionBasis      String
  permissionEvidenceId String
  consentRecordId      String?
  certificationId      String
  membershipId         String
  assignmentGeneration Int
  locationAttemptId    String?
  locationExceptionId  String?
  surface              String
  actorKind            String?
  decision             String   @default("ALLOWED")
  evidenceHash         String
  snapshotJson         String   @db.NVarChar(Max)
  createdAt            DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([vendorId, createdAt])
  @@index([assessmentId, membershipId])
  @@index([evidenceHash])
  @@map("recording_gate_decision_evidence")
}

model MediaUploadAttempt {
  id                String    @id @default(cuid())
  assetId           String    @unique
  vendorId          String
  bookingId         String
  mediaSessionId    String
  membershipId      String
  stage             String
  captureProvenance String
  state             String    @default("UPLOADING")
  blobKey           String
  expectedBytes     BigInt
  actualBytes       BigInt?
  mimeType          String
  durationSeconds   Float?
  failureCode       String?
  failureMessage    String?
  attemptCount      Int       @default(1)
  savedAt           DateTime?
  rejectedAt        DateTime?
  retryRequiredAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([bookingId, stage, createdAt])
  @@index([mediaSessionId, state])
  @@index([vendorId, state, updatedAt])
  @@map("media_upload_attempts")
}

model ServiceVideoStageEvidence {
  id                      String   @id @default(cuid())
  bookingId               String
  vendorId                String
  stage                   String
  stageVersion            Int
  isCurrent               Boolean  @default(true)
  mediaSessionId          String
  mediaAssetId            String   @unique
  assessmentId            String
  assessmentGeneration    Int
  permissionBasis         String
  permissionEvidenceId    String
  recordingGateDecisionId String
  employeeMembershipId    String
  captureProvenance       String
  contentHash             String
  hashAlgorithm           String   @default("SHA-256")
  verifiedDurationSeconds Float
  uploadState             String   @default("SAVED")
  replacesStageEvidenceId String?
  publicEligible          Boolean  @default(false)
  savedAt                 DateTime @default(now())
  createdAt               DateTime @default(now())

  @@unique([bookingId, stage, stageVersion])
  @@index([bookingId, isCurrent])
  @@index([recordingGateDecisionId])
  @@index([contentHash])
  @@map("service_video_stage_evidence")
}

model ServiceVideoPackageEvidence {
  id                      String   @id @default(cuid())
  bookingId               String
  vendorId                String
  version                 Int
  isCurrent               Boolean  @default(true)
  status                  String   @default("AWAITING_MANAGER_REVIEW")
  stageEvidenceJson       String   @db.NVarChar(Max)
  packageHash             String
  submittedByUserId       String?
  submittedByMembershipId String
  submittedAt             DateTime @default(now())
  managerDecisionId       String?
  adminAuditDecisionId    String?
  customerAccessGrantId   String?
  auditEvidenceVersion    Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

