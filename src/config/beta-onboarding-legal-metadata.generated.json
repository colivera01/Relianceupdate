      "presentation": {
        "title": "Manager Work Record attestation required before Service Order release",
        "attestationText": "I am authorized to manage this Work Record for the Vendor shown. I confirm that the assigned service professional and the job, location, recording boundary, participant roles, audio setting, purpose, and stages entered by the Vendor are accurate to the best of my knowledge. I understand that I cannot make the Customer's recording or Public choice, an Employee's job-specific Recording Participation choice, or an Employee's standing Public participation choice.",
        "confirmationText": "I confirm this exact current Work Record, assignment, and recording context for the identified Vendor.",
        "disclaimerText": "This attestation is an operational Vendor statement. It is not Employee consent, Customer authorization, Reliance Audit, or certification of workmanship, safety, licensure, insurance, or code compliance.",
        "actionLabel": "Confirm Work Record Attestation"
      }
    }
